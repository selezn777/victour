# Telegram-бот для заявок (/api/park-booking и другие notify-* роуты)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: перевод комментария в заявке /park на английский
DEEPL_API_KEY=

# Необязательно: ключ подписи ссылок «Подтверждаю выезд» (/park/confirm/...).
# Если пусто — используется TELEGRAM_BOT_TOKEN. При смене ключа старые ссылки перестают работать.
PARK_CONFIRM_SECRET=

# Выбор отеля на Google Картах в форме /park (Maps JavaScript API + Places API (New),
# ограничить ключ по HTTP referrer доменом сайта). Без ключа — обычное поле ввода.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
